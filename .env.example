# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real keys or your address.

# Resend API key — create at https://resend.com/api-keys
RESEND_API_KEY=

# Inbox where contact-form submissions are delivered (your private address)
CONTACT_TO_EMAIL=

# Cloudflare Turnstile (spam protection) — create a widget at
# https://dash.cloudflare.com → Turnstile, hostname donkrumpos.com.
# Both optional: the form works without them; verification enforces once set.
# In Cloudflare Pages, PUBLIC_TURNSTILE_SITE_KEY must be a BUILD-time variable
# (the contact page is static); TURNSTILE_SECRET_KEY is a runtime secret.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
