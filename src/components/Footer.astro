---
// The colophon: a heavy rule, the practice line, and the imprint.
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__main">
      <p class="site-footer__line">
        Finding the story of a place, and giving it form.
      </p>
      <p class="site-footer__yonder">
        I also run <a href="https://yonderartland.com">Yonder</a>, a studio and
        gallery in Algoma, with Erin LaBonte. Murals, prints, and creative work.
      </p>
    </div>
    <div class="site-footer__meta label">
      <span>Algoma, Wisconsin · 44.61° N · 87.43° W</span>
      <span>&copy; {year} Don Krumpos</span>
    </div>
  </div>
</footer>

<style>
  .site-footer__main {
    max-width: 34rem;
  }

  .site-footer__line {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    font-size: 1.5rem;
    line-height: 1.2;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-sm);
  }

  .site-footer__yonder {
    font-size: 0.92rem;
    color: var(--ink-muted);
  }

  .site-footer__meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 6px;
    text-align: right;
  }

  @media (max-width: 768px) {
    .site-footer__meta {
      align-items: flex-start;
      text-align: left;
    }
  }
</style>
