---
// The shop front: a top strip, then the DK monogram + tracked-caps wordmark
// and the nav. Styles live in global.css (SHELL).
import { getCollection } from 'astro:content';

const currentPath = Astro.url.pathname;

// Field Notes joins the nav once the first note is published.
const publishedNotes = await getCollection('notes', ({ data }) => !data.draft);

const navLinks = [
  { href: '/work/', label: 'Work' },
  ...(publishedNotes.length ? [{ href: '/field-notes/', label: 'Field Notes' }] : []),
  { href: '/worlds/', label: 'Worlds' },
  { href: '/services/', label: 'Services' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];
---

<div class="strip label">
  <span>Don Krumpos · Design &amp; Build</span>
  <span>Algoma, Wisconsin · 25 years at the trade</span>
</div>

<header class="site-header">
  <a class="wm" href="/" aria-label="Don Krumpos, home">
    <img class="wm__mark" src="/images/home/dk-ink.png" alt="" width="128" height="144" />
    <span class="wm__name">Don Krumpos</span>
  </a>
  <nav aria-label="Main">
    <ul class="site-nav">
      {navLinks.map(link => (
        <li>
          <a
            href={link.href}
            class:list={[{ active: currentPath.startsWith(link.href) }]}
            aria-current={currentPath.startsWith(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
