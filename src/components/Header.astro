---
import { getCollection } from 'astro:content';

const currentPath = Astro.url.pathname;

// Field Notes joins the nav once the first note is published.
const publishedNotes = await getCollection('notes', ({ data }) => !data.draft);

const navLinks = [
  { href: '/work/', label: 'Work' },
  ...(publishedNotes.length ? [{ href: '/field-notes/', label: 'Field Notes' }] : []),
  { href: '/worlds/', label: 'Worlds' },
  { href: '/services/', label: 'Services' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];
---

<header class="site-header">
  <div class="container">
    <div class="site-name">
      <a href="/">Don Krumpos</a>
      <span class="site-name__sub">Place &amp; Story · Algoma, Wisconsin</span>
    </div>
    <nav aria-label="Main">
      <ul class="site-nav">
        {navLinks.map(link => (
          <li>
            <a
              href={link.href}
              class:list={[{ active: currentPath.startsWith(link.href) }]}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
