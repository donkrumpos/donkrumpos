---
import Base from '../layouts/Base.astro';

// Illustrated Worlds — a gallery of Don's personal, invented, illustrated
// narrative projects. Distinct from client /work.
// Images live in public/worlds/ (copied + downscaled from the widdershins,
// yonder-site, and reliquary art-archive repos, 2026-08). Copy is in Don's own
// maker voice — facts checked against widdershins/reliquary source content, not
// the in-world archive framing. Only verified hand-made work appears here (the
// AI comp studies in reliquary's green-man folder are deliberately excluded).

const plates = [
  {
    id: 'widdershins-tarot',
    num: 'I',
    title: 'The Widdershins Tarot',
    meta: 'Illustrated cards & hand lettering · ongoing · carved, printed & mailed',
    body: 'A Major Arcana for the Widdershins world — twenty-two cards on the standard tarot spine, with my own invented inhabitants in the old roles. The cards arrive in whatever order they show up, and the seasonal ones are working objects: printed as actual cards and mailed out, around a hundred hand-addressed envelopes at the turning of the year. The Green Man holds XIX, The Sun, at midsummer; Krampus keeps the dark half of the year.',
    note: 'A tarot card is the strictest cover brief I know: one figure, one title, one world, read at hand size. Figure, lettering, and border are a single drawing.',
    aspect: 'cards',
    images: [
      { src: '/worlds/tarot-1.jpg', alt: 'The Green Man: a face of layered leaves and flowers in bold black carved line, printed on green paper.' },
      { src: '/worlds/tarot-2.jpg', alt: 'The Krampus card: a horned, hoofed figure with a switch and lantern in white carved line on black, under hand-cut KRAMPUS lettering.' },
    ],
  },
  {
    id: 'the-sideshow',
    num: 'II',
    title: 'The Sideshow',
    meta: 'Copper etchings · 2013 · Highpoint Center for Printmaking, Minneapolis',
    body: 'Six seventeen-inch copper etchings of a circus that never quite makes the main tent: a crowned crocodile serving as a dirigible, an antlered giant carrying a fanged cat-imp, a carousel horse led through on small wheels. I etched the plates at Highpoint Center for Printmaking in my last Minneapolis year; the set first showed at Highpoint’s Threshold Gallery in 2013 and traveled on to print conferences and national exhibitions.',
    note: 'The earliest full company of my abiding subject — the performers at the margins of things, half graceful and half grotesque.',
    aspect: 'square',
    images: [
      { src: '/worlds/sideshow-1.jpg', alt: 'Copper etching: a crocodile wearing a crown serves as a dirigible, a bathtub gondola of long-necked birds slung beneath it; a round figure tows a chained diving-bell machine across a scrubby field.' },
      { src: '/worlds/sideshow-2.jpg', alt: 'Copper etching: a melancholy antlered giant holds a fishbowl with a shrimp inside while a fanged cat-imp rides its back; a mouse beats a bass drum beside a riveted beehive machine.' },
      { src: '/worlds/sideshow-3.jpg', alt: 'Copper etching: a great carousel horse with armored wooden legs on small wheels, led by a bear in top hat and tails while a pig walks a tightrope above.' },
    ],
  },
  {
    id: 'the-posters',
    num: 'III',
    title: 'The Posters',
    meta: 'Illustrated posters & hand lettering · 2016–17 · Door County & De Pere, Wisconsin',
    body: 'Event posters where a title and an illustrated world share one frame. For Ephraim’s Fyr Bal Festival — the village’s Scandinavian welcome-to-summer, bonfires lit along Eagle Harbor — flaming bål torches, a hare, and a crow in engraving-weight line, with one hit of fire-orange in the lettering. For No Moon Theatre’s Box Store Bird, a moonlit pen-and-ink frame of owls, fireflies, and a salamander, the show’s name in a loose hand script at the center. Published under the Yonder studio flag; the illustration and lettering on these are mine alone.',
    note: 'This is the cover job at street scale: a single image that has to set a tone, carry the details, and make a stranger want to come.',
    aspect: 'posters',
    images: [
      { src: '/worlds/poster-1.jpg', alt: 'Ephraim Fyr Bal Festival poster: hand-lettered title in red and black framed by two flaming bål torches, a hare and a crow in dense engraving-style pen-and-ink, with the Ephraim church and harbor below.' },
      { src: '/worlds/poster-2.jpg', alt: 'Box Store Bird theater poster: a moonlit pen-and-ink botanical frame with a great owl, salamander, mouse, and yellow fireflies around the show title in loose teal hand-lettered script.' },
    ],
  },
  {
    id: 'terra-incognita',
    num: 'IV',
    title: 'Terra Incognita',
    meta: 'Watercolor & drawing · 2023–24 · shown in Other Worlds, NEWArtSpace, De Pere WI',
    body: 'A cartography of the boyhood lands of Northeast Wisconsin, drawn in the voice of a natural historian who never existed. Ley lines, land wights, genius loci, and micro-seasons, all rendered as if surveyed from life. Shown by invitation alongside Jason DeMarte and Kristine Granger.',
    note: 'The whole series is an argument that an invented world holds together only when you draw it like a real one.',
    aspect: 'square',
    images: [
      { src: '/worlds/terra-1.jpg', alt: 'Terra Incognita, watercolor and ink — an invented map plate of Northeast Wisconsin.' },
      { src: '/worlds/terra-2.jpg', alt: 'Terra Incognita, watercolor and ink — a second cartographic study with annotations.' },
      { src: '/worlds/terra-3.jpg', alt: 'Terra Incognita, watercolor and ink — a further plate in the invented survey.' },
    ],
  },
  {
    id: 'cabinet',
    num: 'V',
    title: 'Cabinet of the Wilding Hours',
    meta: 'Installation & watercolor · 2025 · duo exhibition with Erin LaBonte',
    body: 'A life-sized field-naturalist’s wagon, twelve watercolor studies, and a full apparatus of field notes, built as one immersive cabinet. The wagon and a watercolor were acquired by the gallery.',
    note: 'Concept to object: the cart, the specimens, the labels, and the hand-lettered tags are all mine.',
    images: [
      { src: '/worlds/cabinet-1.jpg', alt: 'The Cabinet of the Wilding Hours: a life-sized field-naturalist’s wagon, front view.' },
      { src: '/worlds/cabinet-2.jpg', alt: 'The Cabinet of the Wilding Hours: interior of the wagon, hung with roots and specimens.' },
    ],
  },
  {
    id: 'ruins',
    num: 'VI',
    title: 'The Ruins of the Midwest',
    meta: 'Salvage sculpture · 2006 · built at UW–Green Bay',
    body: 'In the year my family’s farm was breaking up, I built machines out of what it threw away. A trebuchet rebuilt from a burned harvest thresher that flung clay-and-seed balls out over a former field. A sensory-deprivation float tank welded from the horse trough my sister and I swam in as kids. Each one takes the farm apart and sends it somewhere it might come up again.',
    note: 'Made from what was already there, without asking permission. Half of what I built that year was made by not asking.',
    images: [
      { src: '/worlds/ruins-1.jpg', alt: 'The trebuchet: a throwing machine rebuilt from a burned farm thresher, standing in gravel before a weathered gray barn.' },
      { src: '/worlds/ruins-2.jpg', alt: 'The tank: a sensory-deprivation float chamber welded from an old farm horse trough, set on skids.' },
    ],
  },
  {
    id: 'painted-walls',
    num: 'VII',
    title: 'The Painted Walls',
    meta: 'Murals & hand lettering · 40+ works across eight Wisconsin cities',
    body: 'Forty-plus public murals carried from concept to finished wall. The designs originate at my drawing table; the painting is a crew — most walls with Erin LaBonte under Yonder, with David Carpenter alongside on recent ones. Featured statewide in Our Wisconsin, 2026. Pictured: the Loodoo, a Lake Michigan water-wolf rising past a drowned shipwreck to meet a lantern-bearing diver, in an Algoma alley; the Mill Madonnas, a monumental wall in Oshkosh’s Sawdust District honoring the women of the lumber boom; and the harbor mermaid, her song composed around the windows of an entire building face. Where a wall calls for type, the lettering is painted by hand.',
    note: 'I research the collaborators, set the concept, and carry it to a finished piece on a wall. It is art direction at the scale of a building.',
    aspect: 'walls',
    images: [
      { src: '/worlds/walls-1.jpg', alt: 'The Loodoo mural, Algoma: a lantern-bearing diver in an antique dive suit meets a serpentine white water-wolf coiling through blue water above a drowned shipwreck, portholes glowing along its body.' },
      { src: '/worlds/walls-2.jpg', alt: 'Mill Madonnas mural, Oshkosh: a haloed madonna in blue robes holds a sleeping child beside a raven, framed by oak boughs, sun and moon charms, and twin lumber-mill scenes at dusk.' },
      { src: '/worlds/walls-3.jpg', alt: 'Harbor mermaid mural, Algoma: a full building face painted around its windows — a mermaid playing a golden harp at moonrise, her scaled tail winding through waves and orange poppies.' },
    ],
  },
  {
    id: 'portage-year',
    num: 'VIII',
    title: 'Portage Year: An Almanach',
    meta: 'Assemblage · collagraph, etching & found objects · 2013',
    body: 'A cosmological almanac built into a found doll’s case: a gilt dome and an orrery of clock gears and marbles over two lit chambers, skinned in my own older prints and pressure-fit together without a drop of glue. Part clock, part reliquary, part map of a single year of returning home.',
    note: 'Every part is the material of the ground the year was kept on. The dome of heaven is a dog’s ball, found in the street, halved and painted gold.',
    aspect: 'cards',
    images: [
      { src: '/worlds/portage-1.jpg', alt: 'Portage Year: An Almanach — the closed assemblage in a found doll’s case, with gilt dome, orrery, and two chambers.' },
      { src: '/worlds/portage-2.jpg', alt: 'Portage Year: An Almanach — detail of the two chambers beneath the orrery dial.' },
    ],
  },
];
---

<Base
  title="Illustrated Worlds — Don Krumpos"
  description="Personal, invented, illustrated narrative worlds by Don Krumpos: a hand-made tarot, copper-etched circuses, hand-lettered posters, cartography, a naturalist's cabinet, murals, and an assemblage almanac."
  ogImage="/worlds/og-worlds.jpg"
>
  <div class="page-header">
    <h1 class="page-header__title">Illustrated Worlds</h1>
    <p class="page-header__subtitle">
      The personal work behind the practice — invented territory, made by hand.
    </p>
  </div>

  <p class="worlds-intro prose">
    Alongside the client work, I build illustrated narrative worlds of my own:
    a tarot deck for an invented territory, an etched circus of the in-between,
    hand-lettered festival posters,
    cartographies of places that were never surveyed, a naturalist’s cabinet,
    machines salvaged from a vanishing farm, forty painted walls, and an almanac
    of a single year. I set the direction and I make the marks.
  </p>

  <div class="plates">
    {plates.map((p) => (
      <article class="plate" id={p.id}>
        <div class="plate__body prose">
          <span class="plate__num">Plate {p.num}</span>
          <h2 class="plate__title">{p.title}</h2>
          <p class="plate__meta">{p.meta}</p>
          <p class="plate__desc">{p.body}</p>
          <p class="plate__note">{p.note}</p>
        </div>
        <div class={`gallery gallery--${p.images.length}${p.aspect ? ` gallery--${p.aspect}` : ''}`}>
          {p.images.map((img) => (
            <figure class="gallery__item">
              <img src={img.src} alt={img.alt} loading="lazy" decoding="async" />
            </figure>
          ))}
        </div>
      </article>
    ))}
  </div>

  <aside class="worlds-cta prose">
    <p>
      More at <a href="https://widdershins.ink">widdershins.ink</a> and
      <a href="https://yonderartland.com">yonderartland.com</a>. For commissions
      or collaboration, <a href="/contact/">get in touch</a>.
    </p>
  </aside>
</Base>

<style>
  .worlds-intro {
    margin-top: var(--space-lg);
    font-size: 1.1rem;
    color: var(--color-text);
  }

  .plates {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
    margin-top: var(--space-2xl);
  }

  .plate {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .plate__body {
    min-width: 0;
  }

  .plate__num {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-light);
    margin-bottom: var(--space-sm);
  }

  .plate__title {
    font-size: 1.9rem;
    margin-bottom: var(--space-sm);
  }

  .plate__meta {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.03em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-md);
  }

  .plate__desc {
    color: var(--color-text);
  }

  .plate__note {
    margin-top: var(--space-md);
    padding-left: var(--space-md);
    border-left: 2px solid var(--color-accent);
    font-style: italic;
    color: var(--color-text-muted);
  }

  /* Image galleries */
  .gallery {
    display: grid;
    gap: var(--grid-gap);
    grid-template-columns: repeat(2, 1fr);
  }
  .gallery--3 {
    grid-template-columns: repeat(3, 1fr);
  }

  .gallery__item {
    margin: 0;
    overflow: hidden;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }

  .gallery__item img {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
    transition: transform var(--transition);
  }

  .gallery__item:hover img {
    transform: scale(1.02);
  }

  /* Aspect variants: tall for the tarot cards, square for the etchings */
  .gallery--cards img {
    aspect-ratio: 7 / 10;
  }
  .gallery--square img {
    aspect-ratio: 1 / 1;
  }
  .gallery--posters img {
    aspect-ratio: 3 / 4;
  }
  /* Murals stack full-width at their natural proportions so whole walls read */
  .gallery--walls {
    grid-template-columns: 1fr;
  }
  .gallery--walls img {
    aspect-ratio: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery__item img { transition: none; }
    .gallery__item:hover img { transform: none; }
  }

  .worlds-cta {
    margin-top: var(--space-2xl);
    padding-top: var(--space-xl);
    border-top: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }

  .worlds-cta a {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 640px) {
    .gallery,
    .gallery--3 {
      grid-template-columns: 1fr 1fr;
    }
    .gallery--walls {
      grid-template-columns: 1fr;
    }
  }
</style>
