---
import Base from '../../layouts/Base.astro';
import ProofCard from '../../components/ProofCard.astro';
import { getCollection } from 'astro:content';
import { jobBook, kindName } from '../../lib/work';
import { imageSize } from '../../lib/images';

// The book has two parts (2026-11-11): a few lead proofs shown large, then a
// ledger of everything else, one line per job. Murals are off this site (they
// live with Yonder), so 'Public Art' entries stay drafts. The order lives in
// src/lib/work.ts.
const { leads, ledger } = jobBook(await getCollection('projects'));

// "Client — What it was" titles split into the two ledger columns.
const split = (title: string) => {
  const [name, ...rest] = title.split(' — ');
  return { name, what: rest.join(' — ') };
};
// Until there is an `award` field, read it from the description.
const award = (d: { description: string }) =>
  d.description.includes('Awwwards') ? 'Awwwards Site of the Day' : '';
---

<Base title="Work | Don Krumpos" description="Product design, design systems, maps and the systems behind them: twenty-five years of work by Don Krumpos.">
  <div class="page-header" data-art="lighthouse">
    <span class="label">The job book</span>
    <h1 class="page-header__title">Software, maps &amp; <em>systems</em></h1>
    <p class="page-header__subtitle">Product design, design systems, maps and the tools behind them. Twenty-five years of work, start to finish.</p>
  </div>

  <section class="work-section">
    <h2 class="work-section__title"><span class="wood">Lead proofs</span></h2>
    <div class="project-grid project-grid--lead">
      {leads.map((project, i) => {
        const d = project.data;
        const facts: [string, string][] = [];
        if (d.client) facts.push(['Client', d.client]);
        if (d.role) facts.push(['Role', d.role]);
        facts.push(['Run', String(d.date.getUTCFullYear())]);
        return (
          <ProofCard
            href={`/work/${project.id}/`}
            proof={`Proof ${String(i + 1).padStart(2, '0')}${d.client ? ` · ${d.client}` : ''}`}
            img={{ src: d.thumbnail, alt: '', ...imageSize(d.thumbnail) }}
            kind={kindName[d.category] ?? d.category}
            title={d.title}
            blurb={d.description}
            facts={facts}
            eager={i < 2}
          />
        );
      })}
    </div>
  </section>

  <section class="work-section">
    <h2 class="work-section__title"><span class="wood">Also in the book</span></h2>
    <ol class="ledger">
      {ledger.map(project => {
        const d = project.data;
        const { name } = split(d.title);
        return (
          <li>
            <a class="ledger__row" href={`/work/${project.id}/`}>
              <span class="ledger__year label">{d.date.getUTCFullYear()}</span>
              <span class="ledger__name">{name}</span>
              <span class="ledger__what">{kindName[d.category] ?? d.category}</span>
              <span class="ledger__note label">{award(d)}</span>
              <span class="ledger__go" aria-hidden="true">→</span>
            </a>
          </li>
        );
      })}
    </ol>
    <p class="ledger__ask">
      There is more in the drawers than fits on this page.
      <a href="/contact/">Ask about any job in the book →</a>
    </p>
  </section>
</Base>
