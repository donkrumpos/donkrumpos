---
import Base from '../../layouts/Base.astro';
import ProofCard from '../../components/ProofCard.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => {
    if (a.data.order !== undefined && b.data.order !== undefined) {
      return a.data.order - b.data.order;
    }
    if (a.data.order !== undefined) return -1;
    if (b.data.order !== undefined) return 1;
    return b.data.date.getTime() - a.data.date.getTime();
  });

// Group by category. Murals are off this site (2026-11-11; they live with
// Yonder), so 'Public Art' entries stay drafts. The schema enum is unchanged.
const categories = ['Public Art', 'Web & Systems', 'Design Systems', 'UI/UX', 'Branding', 'Print'] as const;
const displayName: Record<string, string> = {
  'Public Art': 'Walls',
  'Web & Systems': 'Maps, tools & systems',
  'Design Systems': 'Design systems',
  'UI/UX': 'Product & web design',
  'Branding': 'Brand',
  'Print': 'Print',
};
const grouped = categories
  .map(cat => ({
    name: cat,
    projects: projects.filter(p => p.data.category === cat),
  }))
  .filter(g => g.projects.length > 0);

// Proofs are numbered straight through the book, across sections.
let proofNo = 0;
---

<Base title="Work | Don Krumpos" description="Product design, design systems, maps and the systems behind them: twenty-five years of work by Don Krumpos.">
  <div class="page-header" data-art="lighthouse">
    <span class="label">The job book</span>
    <h1 class="page-header__title">Software, maps <em>&amp; systems</em></h1>
    <p class="page-header__subtitle">Product design, design systems, maps and the tools behind them. Twenty-five years of work, start to finish.</p>
  </div>

  {grouped.map(group => (
    <section class="work-section">
      <h2 class="work-section__title">
        <span class="wood">{displayName[group.name] ?? group.name}</span>
        {group.name === 'Public Art' && (
          <a href="https://www.yonderartland.com/murals/">Every wall on the map →</a>
        )}
      </h2>
      <div class="project-grid">
        {group.projects.map(project => {
          proofNo += 1;
          const d = project.data;
          const facts: [string, string][] = [];
          if (d.client) facts.push(['Client', d.client]);
          if (d.role) facts.push(['Role', d.role]);
          facts.push(['Run', String(d.date.getFullYear())]);
          return (
            <ProofCard
              href={`/work/${project.id}/`}
              proof={`Proof ${String(proofNo).padStart(2, '0')}${d.client ? ` · ${d.client}` : ''}`}
              img={{ src: d.thumbnail, alt: '' }}
              kind={displayName[d.category] ?? d.category}
              title={d.title}
              blurb={d.description}
              facts={facts}
              eager={proofNo <= 3}
            />
          );
        })}
      </div>
    </section>
  ))}
</Base>
