---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => {
    if (a.data.order !== undefined && b.data.order !== undefined) {
      return a.data.order - b.data.order;
    }
    if (a.data.order !== undefined) return -1;
    if (b.data.order !== undefined) return 1;
    return b.data.date.getTime() - a.data.date.getTime();
  });

// Group by category. Murals lead (they're the core of the practice); the
// display names speak Place & Story while the schema enum stays unchanged.
const categories = ['Public Art', 'Web & Systems', 'Design Systems', 'UI/UX', 'Branding', 'Print'] as const;
const displayName: Record<string, string> = {
  'Public Art': 'Walls',
  'Web & Systems': 'Maps, tools & systems',
  'Design Systems': 'Design systems',
  'UI/UX': 'Product & web design',
  'Branding': 'Brand',
  'Print': 'Print',
};
const grouped = categories
  .map(cat => ({
    name: cat,
    projects: projects.filter(p => p.data.category === cat),
  }))
  .filter(g => g.projects.length > 0);
---

<Base title="Work | Don Krumpos" description="Murals, interpretive maps, the systems behind them, and twenty-five years of product and brand design.">
  <div class="page-header">
    <span class="label">Work</span>
    <h1 class="page-header__title" style="margin-top:0.8rem">Walls, maps <em>&amp; systems</em></h1>
    <p class="page-header__subtitle">Murals, interpretive maps and the systems behind them, plus twenty-five years of product and brand design.</p>
  </div>

  {grouped.map(group => (
    <section class="work-section">
      <h2 class="work-section__title">
        {displayName[group.name] ?? group.name}
        {group.name === 'Public Art' && (
          <a class="work-section__more" href="https://www.yonderartland.com/murals/">Every wall on the map →</a>
        )}
      </h2>
      <div class="project-grid">
        {group.projects.map(project => (
          <ProjectCard
            title={project.data.title}
            description={project.data.description}
            thumbnail={project.data.thumbnail}
            slug={project.id}
            category={project.data.category}
            client={project.data.client}
          />
        ))}
      </div>
    </section>
  ))}
</Base>

<style>
  .work-section__title {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }

  .work-section__more {
    font-size: 0.66rem;
    letter-spacing: 0.12em;
  }
</style>
