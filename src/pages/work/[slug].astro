---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { kindName, nextProject } from '../../lib/work';

export async function getStaticPaths() {
  // Drafts are never built. Unlisted projects are built but noindexed.
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map(project => ({
    params: { slug: project.id },
    props: { project, next: nextProject(project, projects) },
  }));
}

const { project, next } = Astro.props;
const { Content } = await render(project);

const dateFormatted = project.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
});

const heroSrc = project.data.images?.[0] || project.data.thumbnail;
const { liveUrl } = project.data;

// Link previews cannot show an SVG. A case study whose thumbnail is one gets
// a raster card from scripts/build-og.mjs, named for the project.
const shareImage = project.data.thumbnail.endsWith('.svg')
  ? `/images/og/${project.id}.jpg`
  : project.data.thumbnail;
---

<Base title={`${project.data.title} — Don Krumpos`} description={project.data.description} noindex={project.data.unlisted} ogImage={shareImage}>
  <div class="project-detail">
    <a href="/work/" class="back-link">&larr; Back to work</a>

    <header class="page-header">
      <span class="label">{project.data.category}</span>
      <h1>{project.data.title}</h1>
      <p class="page-header__subtitle">{project.data.description}</p>
    </header>

    {/* Case study metadata */}
    <div class="project-detail__meta-grid">
      {project.data.client && (
        <div class="meta-item">
          <span class="meta-label">Client</span>
          <span class="meta-value">{project.data.client}</span>
        </div>
      )}
      {project.data.role && (
        <div class="meta-item">
          <span class="meta-label">Role</span>
          <span class="meta-value">{project.data.role}</span>
        </div>
      )}
      <div class="meta-item">
        <span class="meta-label">Run</span>
        <span class="meta-value">{dateFormatted}</span>
      </div>
      {project.data.tools && project.data.tools.length > 0 && (
        <div class="meta-item">
          <span class="meta-label">Tools</span>
          <span class="meta-value">{project.data.tools.join(', ')}</span>
        </div>
      )}
    </div>

    {/* Hero image */}
    <div class="project-detail__hero">
      <div class="proof-sheet">
        <i class="reg"></i><i class="reg"></i><i class="reg"></i><i class="reg"></i>
        {liveUrl ? (
          /* Image link duplicates the CTA, so keep it out of the tab order */
          <a href={liveUrl} target="_blank" rel="noopener" class="project-detail__hero-link" tabindex="-1" aria-hidden="true">
            <img src={heroSrc} alt="" />
          </a>
        ) : (
          <img src={heroSrc} alt={project.data.title} />
        )}
      </div>
      {liveUrl && (
        <a href={liveUrl} target="_blank" rel="noopener" class="project-detail__live-cta">
          See it live right now &rarr;<span class="sr-only"> (opens in a new tab)</span>
        </a>
      )}
    </div>

    {/* Case study body — markdown */}
    <div class="project-detail__body post-body">
      <Content />
    </div>

    {/* Additional images */}
    {project.data.images && project.data.images.length > 1 && (
      <div class="project-detail__gallery">
        {project.data.images.slice(1).map((img, i) => (
          <img src={img} alt={`${project.data.title} — detail ${i + 2}`} loading="lazy" />
        ))}
      </div>
    )}

    {/* The ending: the next piece, and a way to start a conversation */}
    <footer class="case-end">
      {next && (
        <a class="case-end__card case-end__next" href={`/work/${next.id}/`}>
          <span class="label">Next in the book</span>
          <span class="case-end__title">{next.data.title}</span>
          <span class="case-end__kind label">{kindName[next.data.category] ?? next.data.category} <span aria-hidden="true">→</span></span>
        </a>
      )}
      <div class="case-end__card">
        <span class="label">Start a project</span>
        <p class="case-end__title">Working on something like this?</p>
        <p class="case-end__actions">
          <a class="button" href="/contact/">Start a conversation <span aria-hidden="true">→</span></a>
          <a class="button button--ghost" href="/work/">All work</a>
        </p>
      </div>
    </footer>
  </div>
</Base>
