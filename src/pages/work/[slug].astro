---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { existsSync } from 'node:fs';
import { kindName, nextProject } from '../../lib/work';
import { imageSize } from '../../lib/images';

export async function getStaticPaths() {
  // Drafts are never built. Unlisted projects are built but noindexed.
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map(project => ({
    params: { slug: project.id },
    props: { project, next: nextProject(project, projects) },
  }));
}

const { project, next } = Astro.props;
const { Content } = await render(project);

const dateFormatted = project.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  timeZone: 'UTC', // dates are written as plain days; local time would slip a year
});

const heroSrc = project.data.images?.[0] || project.data.thumbnail;
const { liveUrl, fullPage, stats, statsNote, fit, ask } = project.data;
// Inquiries from a case study arrive labelled with it.
const contactHref = `/contact/?about=${project.id}`;

// Link previews use the thumbnail, unless scripts/build-og.mjs has made a
// card for this project (it does for SVG and very tall thumbnails).
const shareImage = existsSync(`public/images/og/${project.id}.jpg`)
  ? `/images/og/${project.id}.jpg`
  : project.data.thumbnail;
---

<Base title={`${project.data.title} — Don Krumpos`} description={project.data.description} noindex={project.data.unlisted} ogImage={shareImage}>
  <div class="project-detail">
    <a href="/work/" class="back-link">&larr; Back to work</a>

    <header class="page-header">
      <span class="label">{project.data.category}</span>
      <h1>{project.data.title}</h1>
      <p class="page-header__subtitle">{project.data.description}</p>
    </header>

    {/* Case study metadata */}
    <div class="project-detail__meta-grid">
      {project.data.client && (
        <div class="meta-item">
          <span class="meta-label">Client</span>
          <span class="meta-value">{project.data.client}</span>
        </div>
      )}
      {project.data.role && (
        <div class="meta-item">
          <span class="meta-label">Role</span>
          <span class="meta-value">{project.data.role}</span>
        </div>
      )}
      <div class="meta-item">
        <span class="meta-label">Run</span>
        <span class="meta-value">{dateFormatted}</span>
      </div>
      {project.data.tools && project.data.tools.length > 0 && (
        <div class="meta-item">
          <span class="meta-label">Tools</span>
          <span class="meta-value">{project.data.tools.join(', ')}</span>
        </div>
      )}
    </div>

    {/* Hero image */}
    <div class="project-detail__hero">
      <div class="proof-sheet">
        <i class="reg"></i><i class="reg"></i><i class="reg"></i><i class="reg"></i>
        {liveUrl ? (
          /* Image link duplicates the CTA, so keep it out of the tab order */
          <a href={liveUrl} target="_blank" rel="noopener" class="project-detail__hero-link" tabindex="-1" aria-hidden="true">
            <img src={heroSrc} alt="" {...imageSize(heroSrc)} />
          </a>
        ) : (
          <img src={heroSrc} alt={project.data.title} {...imageSize(heroSrc)} />
        )}
      </div>
      {liveUrl && (
        <a href={liveUrl} target="_blank" rel="noopener" class="project-detail__live-cta">
          See it live right now &rarr;<span class="sr-only"> (opens in a new tab)</span>
        </a>
      )}
    </div>

    {/* Headline results */}
    {stats && stats.length > 0 && (
      <section class="stat-band" aria-label="Results at a glance">
        {statsNote && <p class="stat-band__note label">{statsNote}</p>}
        <ul class="stat-band__row">
          {stats.map((s) => (
            <li class="stat">
              <span class="stat__value">{s.value}</span>
              <span class="stat__label">{s.label}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    {/* Is this your situation? */}
    {fit && (
      <section class="fit" aria-labelledby="fit-h">
        <div>
          <h2 id="fit-h">{fit.heading}</h2>
          <ul class="fit__points">
            {fit.points.map((point) => <li>{point}</li>)}
          </ul>
        </div>
        <div class="fit__ask">
          {fit.note && <p>{fit.note}</p>}
          <a class="button" href={contactHref}>{fit.button} <span aria-hidden="true">→</span></a>
        </div>
      </section>
    )}

    {/* Case study body — markdown */}
    <div class="project-detail__body post-body">
      <Content />
    </div>

    {/* The full-page capture, in a frame that scrolls */}
    {fullPage && (
      <figure class="page-scroll">
        <div class="page-scroll__frame" tabindex="0" role="region" aria-label={`${project.data.title}: the full page, scrollable`}>
          <img src={fullPage} alt={`${project.data.title}: the full page, top to bottom`} loading="lazy" decoding="async" {...imageSize(fullPage)} />
        </div>
        <figcaption class="label">The whole page · scroll inside the frame</figcaption>
      </figure>
    )}

    {/* Additional images */}
    {project.data.images && project.data.images.length > 1 && (
      <div class="project-detail__gallery">
        {project.data.images.slice(1).map((img, i) => (
          <img src={img} alt={`${project.data.title} — detail ${i + 2}`} loading="lazy" decoding="async" {...imageSize(img)} />
        ))}
      </div>
    )}

    {/* The ending: the next piece, and a way to start a conversation */}
    <footer class="case-end">
      {next && (
        <a class="case-end__card case-end__next" href={`/work/${next.id}/`}>
          <span class="label">{project.data.next ? 'More like this' : 'Next in the book'}</span>
          <span class="case-end__title">{next.data.title}</span>
          <span class="case-end__kind label">{kindName[next.data.category] ?? next.data.category} <span aria-hidden="true">→</span></span>
        </a>
      )}
      <div class="case-end__card">
        <span class="label">Start a project</span>
        <p class="case-end__title">{ask?.heading ?? 'Working on something like this?'}</p>
        {ask?.body && <p class="case-end__body">{ask.body}</p>}
        <p class="case-end__actions">
          <a class="button" href={contactHref}>{ask?.button ?? 'Start a conversation'} <span aria-hidden="true">→</span></a>
          <a class="button button--ghost" href="/work/">All work</a>
        </p>
      </div>
    </footer>
  </div>
</Base>
