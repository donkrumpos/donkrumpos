---
import Base from '../layouts/Base.astro';

const success = Astro.url.searchParams.get('success') === 'true';

// Set PUBLIC_TURNSTILE_SITE_KEY in the Cloudflare Pages BUILD environment (this
// page is static, so the key bakes in at build time). Widget renders only when
// the key exists; the API enforces only when TURNSTILE_SECRET_KEY is set.
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<Base title="Contact — Don Krumpos" description="Start a project with Don Krumpos: product design, design systems, maps and the systems behind them.">
  <div class="page-header">
    <span class="label">Start a project</span>
    <h1 class="page-header__title">Contact</h1>
  </div>

  <div class="contact-content">
    <p>
      Tell me what you're working on, and I'll tell you honestly whether I'm the
      right fit. I design and build software, maps and the systems behind them,
      as a design lead for product teams and start to finish for nonprofits and
      the organizations that care for places. Whatever I build is yours to own
      and run.
    </p>

    <form
      id="contact-form"
      class="contact-form"
      action="/api/contact"
      method="POST"
      style={success ? 'display:none;' : ''}
    >
      <div class="form-group">
        <label for="name">Name</label>
        <input type="text" id="name" name="name" required />
      </div>
      <div class="form-group">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" required />
      </div>
      <div class="form-group">
        <label for="message">Message</label>
        <textarea id="message" name="message" rows="6" required></textarea>
      </div>
      <!-- honeypot: real people leave this empty; bots fill it -->
      <div class="hp" aria-hidden="true">
        <label>Company<input type="text" name="company" tabindex="-1" autocomplete="off" /></label>
      </div>
      {turnstileSiteKey && (
        <div
          class="cf-turnstile form-turnstile"
          data-sitekey={turnstileSiteKey}
          data-theme="auto"
        ></div>
      )}
      <button type="submit" class="button form-submit">Send message</button>
    </form>
    <script is:inline>
      // Arriving from /field-study: prompt for the place, not the project.
      if (new URLSearchParams(location.search).get('about') === 'field-study') {
        var m = document.getElementById('message');
        if (m) m.placeholder = 'Tell me about your place: what it is, what you hold, and what you wish more people noticed.';
      }
    </script>
    {turnstileSiteKey && (
      <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    )}

    <div id="form-success" class="form-message" style={success ? '' : 'display:none;'}>
      <p>Thanks for reaching out. I'll get back to you soon.</p>
    </div>

    <div id="form-error" class="form-message form-message--error" style="display:none;">
      <p>
        Something went wrong sending that. Please try again in a moment, or reach me via
        <a href="https://www.linkedin.com/in/donkrumpos/" target="_blank" rel="noopener">LinkedIn</a>.
      </p>
    </div>

    <ul class="contact-links">
      <li>
        <a href="https://www.linkedin.com/in/donkrumpos/" target="_blank" rel="noopener">
          <span>LinkedIn</span>
          <span class="label">linkedin.com/in/donkrumpos</span>
        </a>
      </li>
    </ul>
  </div>
</Base>

<style>
  .contact-form {
    margin-top: var(--space-lg);
    padding: clamp(18px, 3vw, 28px);
    background: var(--paper-bright);
    border: 1px solid var(--ink);
  }

  .form-group {
    margin-bottom: var(--space-md);
  }

  .form-group label {
    display: block;
    font-family: var(--font-label);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin-bottom: 6px;
  }

  .form-group input,
  .form-group textarea {
    width: 100%;
    padding: 0.6rem 0.75rem;
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--rule-strong);
    border-radius: 0;
    transition: border-color var(--transition);
  }

  .form-group input:focus,
  .form-group textarea:focus {
    outline: 2px solid var(--rust);
    outline-offset: 1px;
    border-color: var(--ink);
  }

  .form-group textarea {
    resize: vertical;
  }

  /* honeypot — visually and semantically hidden, still submitted by bots */
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .form-turnstile {
    margin-bottom: var(--space-md);
  }

  .form-submit:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .form-message {
    margin-top: var(--space-lg);
    padding: var(--space-md);
    background: var(--paper-bright);
    border: 1px solid var(--ink);
  }

  .form-message--error {
    border-color: var(--rust);
    border-left-width: 4px;
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const successEl = document.getElementById('form-success');
  const errorEl = document.getElementById('form-error');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (errorEl) errorEl.style.display = 'none';
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = 'Sending...';

    try {
      const data = new FormData(form);
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: data.get('name'),
          email: data.get('email'),
          message: data.get('message'),
          company: data.get('company'),
          'cf-turnstile-response': data.get('cf-turnstile-response'),
        }),
      });

      if (res.ok) {
        form.style.display = 'none';
        if (successEl) successEl.style.display = 'block';
      } else {
        throw new Error('Failed');
      }
    } catch (err) {
      if (errorEl) errorEl.style.display = 'block';
      btn.disabled = false;
      btn.textContent = 'Send message';
      // Turnstile tokens are single-use; reset so a retry gets a fresh one.
      (window as any).turnstile?.reset();
    }
  });
</script>
