---
// Services under the Place & Story umbrella (rewritten 2026-09-23).
// One practice, several forms: maps/interpretive work, donor/CRM systems,
// and design leadership. Murals came off this site 2026-11-11 (they live
// with Yonder).
// FIELD_STUDY_PUBLIC stays false until 2027-01-01 (the /field-study page is
// unlisted while the DCLT contract runs). Flip it with the page's launch.
import Base from '../layouts/Base.astro';
import { imageSize } from '../lib/images';

const FIELD_STUDY_PUBLIC = false;

const forms = [
  {
    n: '01',
    title: 'Maps & interpretive experiences',
    body: 'Story maps, collection browsers, walking tours and archive interfaces that let people explore a place on their phone, or on a screen in the lobby. Hand-built and fast, and yours to keep, with no map vendor renting you access.',
    proof: [
      { label: 'Preserve Explorer', href: '/work/dclt-preserve-explorer/' },
    ],
    img: '/images/projects/dclt-explorer-thumb.jpg',
    alt: 'An interactive map of nature preserves along a peninsula.',
  },
  {
    n: '02',
    title: 'Systems for mission-driven organizations',
    body: 'Donation, registration and CRM systems for small organizations that have outgrown rented platforms. I design and build the whole path, from the form a donor fills out to the record in your database, and hand it to staff on infrastructure they own.',
    proof: [
      { label: 'An owned donor & registration pipeline', href: '/work/dclt-donor-pipeline/' },
    ],
    img: '/images/projects/dclt-pipeline-diagram.svg',
    alt: 'A diagram of a donation flowing from a web form through Stripe and Supabase into Salesforce.',
    contain: true,
  },
  {
    n: '03',
    title: 'Design leadership',
    body: 'Twenty-five years of product and brand design, in-house and as a contract design lead: research, information architecture, and the design systems that hold a product together as it grows.',
    proof: [
      { label: 'NielsenIQ', href: '/work/nielseniq/' },
      { label: 'Optum', href: '/work/optum/' },
      { label: 'Patterson Dental', href: '/work/pattersondental/' },
      { label: 'Nice Ride Minnesota', href: '/work/niceridemn/' },
    ],
    img: '/images/projects/niq-discover.jpg',
    alt: 'The NielsenIQ Discover platform interface.',
  },
];

const principles = [
  { title: 'Research first', body: 'The content is the credibility. Every project starts by finding out what a place, a collection or an organization is actually carrying.' },
  { title: 'Yours to keep', body: 'Owned infrastructure and handed-off files, not subscriptions you can’t leave. You should be able to run it without me.' },
  { title: 'The next version, not upkeep', body: 'When it’s time for more, we build the next version as a new project. I don’t sell maintenance contracts.' },
];
---

<Base
  title="Services | Don Krumpos"
  description="Interpretive maps, the systems behind them, and design leadership. One practice: finding the story of a place and giving it form."
>
  <header class="page-header svc-head" data-art="road">
    <span class="label">Services</span>
    <h1>One practice, <em>several forms</em></h1>
    <p class="page-header__subtitle">
      Everything I make starts the same way: notice what a place is carrying,
      find the story in it, then choose the form that tells it best. Sometimes
      that’s a map. Sometimes it’s a tool, or a whole system.
    </p>
  </header>

  {FIELD_STUDY_PUBLIC && (
    <section class="svc-start reveal">
      <div>
        <span class="label">Where most work starts</span>
        <h2>The Place &amp; Story <em>Field Study</em></h2>
        <p>
          A short, paid visit. I spend time with your place, your collection
          and your people, and come back with a field guide of what they
          could become.
        </p>
      </div>
      <a class="button" href="/field-study/">See the Field Study <span aria-hidden="true">→</span></a>
    </section>
  )}

  <div class="forms">
    {forms.map((f, i) => (
      <section class:list={['form reveal', { 'form--flip': i % 2 === 1 }]}>
        <figure class="plate form__plate">
          <img src={f.img} alt={f.alt} {...imageSize(f.img)} loading={i === 0 ? 'eager' : 'lazy'} class:list={[{ 'is-contain': f.contain }]} />
        </figure>
        <div class="form__text">
          <span class="form__n">{f.n}</span>
          <h2>{f.title}</h2>
          <p>{f.body}</p>
          <ul class="form__proof">
            {f.proof.map((p) => (
              <li><a href={p.href}>{p.label}</a></li>
            ))}
          </ul>
        </div>
      </section>
    ))}
  </div>

  <section class="band">
    <div class="band__inner">
      <span class="label label--gold">How I work</span>
      <h2 class="band__title">Three things <em>every project gets</em></h2>
      <div class="principles">
        {principles.map((p) => (
          <div class="principle">
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-box reveal">
    <h2>What is your place <em>carrying?</em></h2>
    <p>Tell me what you’re working on. If I’m not the right fit, I’ll say so.</p>
    <a class="button" href="/contact/">Start a conversation <span aria-hidden="true">→</span></a>
  </section>
</Base>

<style>
  .svc-start {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-lg);
    margin-top: var(--space-xl);
    padding: var(--space-lg);
    background: var(--paper-bright);
    border: 1px solid var(--ink);
    border-left: 4px solid var(--rust);
  }

  .svc-start h2 {
    margin: 0.3rem 0 0.5rem;
  }

  .svc-start p {
    color: var(--ink-muted);
    max-width: 34rem;
  }

  .forms {
    margin-top: 0;
  }

  .form:first-child {
    border-top: 0;
    padding-top: var(--space-lg);
  }

  .form {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-2xl);
    align-items: center;
    padding: var(--space-2xl) 0;
    border-top: 1px solid var(--rule);
  }

  .form--flip .form__plate {
    order: 2;
  }

  .form__plate img {
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: center top;
  }

  .form__plate img.is-contain {
    object-fit: contain;
    background: var(--paper-bright);
    padding: 1rem;
  }

  .form__n {
    font-family: var(--font-gothic);
    font-weight: 800;
    font-size: 2rem;
    line-height: 1;
    letter-spacing: 0.04em;
    color: var(--rust);
  }

  .form__text h2 {
    margin: 0.5rem 0 var(--space-md);
  }

  .form__text p {
    font-size: 1.1rem;
    color: var(--ink-muted);
  }

  .form__proof {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.4rem;
    margin-top: var(--space-lg);
    padding-top: var(--space-md);
    border-top: 1px dashed var(--rule-strong);
  }

  .form__proof a {
    font-family: var(--font-label);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .form__proof a::after {
    content: ' →';
  }

  .band__title {
    margin: 0.5rem 0 var(--space-xl);
    max-width: 22ch;
  }

  .principles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-xl);
    border-top: 1px solid rgba(233, 223, 203, 0.2);
    padding-top: var(--space-lg);
  }

  .principle h3 {
    font-size: 1.35rem;
    margin-bottom: 0.6rem;
  }

  .principle p {
    font-size: 1.02rem;
  }

  @media (max-width: 860px) {
    .form {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }

    .form--flip .form__plate {
      order: 0;
    }

    .principles {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }

    .svc-start {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
